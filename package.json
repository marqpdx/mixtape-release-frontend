{
  "name": "mixtape-release-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3010 -H localhost",
    "build": "next build",
    "start": "next start -p 3010 -H localhost",
    "lint": "next lint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:local": "chmod +x ./scripts/test-local.sh && ./scripts/test-local.sh"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.90.8",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.13.2",
    "bad-words": "^4.0.0",
    "bad-words-next": "^3.1.1",
    "framer-motion": "^12.19.1",
    "next": "^15.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.66.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.29.0",
