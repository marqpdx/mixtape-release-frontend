{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@mixtape/core": ["./packages/core/src"],
      "@mixtape/core/*": ["./packages/core/src/*"],
      "@mixtape/api": ["./packages/api/src"],
      "@mixtape/api/*": ["./packages/api/src/*"],
      "@mixtape/auth": ["./packages/auth/src"],
      "@mixtape/auth/*": ["./packages/auth/src/*"],
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@contexts/*": ["./src/contexts/*"],
      "@providers/*": ["./src/providers/*"],
      "@lib/*": ["./packages/api/src/clients/*"],
      "@utils/*": ["./src/utils/*"],
      "@types/*": ["./packages/core/src/types/*"],
      "@hooks/*": ["./packages/api/src/hooks/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
}
