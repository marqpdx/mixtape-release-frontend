{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shuttle.place.schema.json",
  "type": "object",
  "properties": {
    "sighting_id": {
      "type": "string",
      "minLength": 1
    },
    "shape_version": {
      "const": "0.1.0"
    },
    "strategy_id": {
      "const": "shuttle.weave_to_packet"
    },
    "strategy_version": {
      "const": "0.1.0"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "source_locator": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": "integer",
            "minimum": 0
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_ref",
          "source_revision",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    },
    "uncertain": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_locator": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "source_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_ref",
                "source_revision",
                "start",
                "end",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": [
          "field",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "shape_id": {
      "const": "shuttle.place"
    },
    "name_as_said": {
      "type": "string",
      "minLength": 1
    },
    "proposed_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "enum": [
        "named_place",
        "locale",
        "unresolved"
      ]
    },
    "address_as_said": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "sighting_id",
    "shape_version",
    "strategy_id",
    "strategy_version",
    "confidence",
    "source_locator",
    "uncertain",
    "shape_id",
    "name_as_said",
    "proposed_name",
    "role"
  ],
  "additionalProperties": false
}
