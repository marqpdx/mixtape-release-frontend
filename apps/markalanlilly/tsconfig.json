{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "paths": {
      "@mixtape/api": ["../../packages/api/src"],
      "@mixtape/api/*": ["../../packages/api/src/*"],
      "@mixtape/auth": ["../../packages/auth/src"],
      "@mixtape/auth/*": ["../../packages/auth/src/*"],
      "@mixtape/content": ["../../packages/content/src"],
      "@mixtape/content/*": ["../../packages/content/src/*"],
      "@mixtape/core": ["../../packages/core/src"],
      "@mixtape/core/*": ["../../packages/core/src/*"],
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
