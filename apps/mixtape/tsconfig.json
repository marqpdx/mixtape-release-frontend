{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "paths": {
      "@mixtape/core": [
        "../../packages/core/src"
      ],
      "@mixtape/core/*": [
        "../../packages/core/src/*"
      ],
      "@mixtape/api": [
        "../../packages/api/src"
      ],
      "@mixtape/api/*": [
        "../../packages/api/src/*"
      ],
      "@mixtape/auth": [
        "../../packages/auth/src"
      ],
      "@mixtape/auth/*": [
        "../../packages/auth/src/*"
      ],
      "@mixtape/content": [
        "../../packages/content/src"
      ],
      "@mixtape/content/*": [
        "../../packages/content/src/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@contexts/*": [
        "./src/contexts/*"
      ],
      "@providers/*": [
        "./src/providers/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@types/*": [
        "../../packages/core/src/types/*"
      ],
      "@hooks/*": [
        "../../packages/api/src/hooks/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
  ]
}
